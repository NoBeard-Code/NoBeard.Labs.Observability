@page "/insights"
@implements IAsyncDisposable
@inject PrometheusClient Prometheus
@inject TenantState Tenant
@inject ILogger<Insights> Logger

<PageTitle>Live insights</PageTitle>

<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <h1 class="mb-0">Live insights</h1>
    <span class="badge text-bg-dark">@Prometheus.SourceName</span>
    <div class="btn-group btn-group-sm ms-auto" role="group">
        <button class="btn @(_operatorView ? "btn-outline-primary" : "btn-primary")" @onclick="() => SetView(false)">
            My tenant (@Tenant.Current)
        </button>
        <button class="btn @(_operatorView ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetView(true)">
            Operator view (all tenants)
        </button>
    </div>
</div>

@if (!Prometheus.IsConfigured)
{
    <div class="alert alert-warning">No Prometheus endpoint configured (<code>Prometheus:BaseUrl</code>). Start the solution via the AppHost.</div>
    return;
}

@if (_error is not null)
{
    <div class="alert alert-warning small">@_error</div>
}

<div class="stat-grid">
    <StatTile Label="Orders / min" Value="_ordersPerMin" />
    <StatTile Label="Revenue (15 min)" Value="_revenue" Unit=" €" Format="#,0" />
    <StatTile Label="Failed orders" Value="_failedPct" Unit=" %" Alert="@(_failedPct > 10)" />
    <StatTile Label="p95 processing" Value="_p95" Unit=" ms" Format="0" Alert="@(_p95 > 1000)" />
    @if (_operatorView)
    {
        <StatTile Label="Active Blazor circuits" Value="_circuits" Format="0" Hint=".NET 10 circuit metrics" />
        <StatTile Label="API 5xx" Value="_api5xx" Unit=" %" Alert="@(_api5xx > 5)" Hint="incl. resilience retries" />
    }
</div>

<div class="row g-3 mt-1">
    <div class="col-xl-6"><LineChart Title="Orders / min by tenant (last 15 min)" Series="_ordersSeries" /></div>
    <div class="col-xl-6"><LineChart Title="Failed orders / min by tenant (last 15 min)" Series="_failureSeries" /></div>
</div>

<h4 class="mt-4">Per tenant</h4>
<table class="table table-sm align-middle">
    <thead><tr><th>Tenant</th><th class="text-end">Orders / min</th><th class="text-end">Failures / min</th><th class="text-end">Revenue 15 min</th><th class="text-end">p95 ms</th></tr></thead>
    <tbody>
        @foreach (var row in _tenantRows)
        {
            <tr class="@(row.FailuresPerMin > 0.2 * Math.Max(row.OrdersPerMin, 1) ? "table-danger" : "")">
                <td><span class="tenant-dot" style="background:@TenantColors.For(row.Tenant)"></span> @row.Tenant</td>
                <td class="text-end">@row.OrdersPerMin.ToString("0.0")</td>
                <td class="text-end">@row.FailuresPerMin.ToString("0.0")</td>
                <td class="text-end">@row.Revenue.ToString("#,0") €</td>
                <td class="text-end">@(double.IsFinite(row.P95) ? row.P95.ToString("0") : "–")</td>
            </tr>
        }
    </tbody>
</table>

@if (_operatorView)
{
    <details class="mt-4">
        <summary>PromQL console (operator only)</summary>
        <div class="d-flex gap-2 mt-2">
            <input class="form-control font-monospace" @bind="_adhocQuery" @bind:event="oninput" @onkeydown="OnAdhocKey" />
            <button class="btn btn-secondary" @onclick="RunAdhocAsync">Run</button>
        </div>
        @if (_adhocResult is not null)
        {
            <table class="table table-sm mt-2 font-monospace small">
                @foreach (var s in _adhocResult)
                {
                    <tr><td>@string.Join(", ", s.Labels.Select(l => $"{l.Key}=\"{l.Value}\""))</td><td class="text-end">@s.Value.ToString("0.###")</td></tr>
                }
            </table>
        }
    </details>
}

<p class="text-muted small mt-3">Refreshed every @RefreshInterval.TotalSeconds s · last update @_lastUpdate?.ToString("HH:mm:ss") ·
    queries go to <code>@Prometheus.BaseUrl</code></p>

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(5);

    private record TenantRow(string Tenant, double OrdersPerMin, double FailuresPerMin, double Revenue, double P95);

    private readonly CancellationTokenSource _cts = new();
    private bool _operatorView;
    private string? _error;
    private DateTime? _lastUpdate;

    private double? _ordersPerMin, _revenue, _failedPct, _p95, _circuits, _api5xx;
    private IReadOnlyList<LineChart.ChartSeries> _ordersSeries = [], _failureSeries = [];
    private IReadOnlyList<TenantRow> _tenantRows = [];

    private string _adhocQuery = "topk(5, sum by (service_name, http_route) (rate(http_server_request_duration_seconds_count[5m])))";
    private IReadOnlyList<PromSample>? _adhocResult;

    protected override void OnInitialized()
    {
        Tenant.Changed += OnTenantChanged;
        _ = RefreshLoopAsync(_cts.Token);
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        // Blazor Server: the timer runs on the server and every refresh is pushed to the browser as a render diff.
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            do
            {
                await RefreshAsync(ct);
            }
            while (await timer.WaitForNextTickAsync(ct));
        }
        catch (OperationCanceledException)
        {
            // page closed
        }
    }

    private async Task RefreshAsync(CancellationToken ct)
    {
        if (!Prometheus.IsConfigured) return;

        var q = new InsightQueries(_operatorView ? null : Tenant.Current);
        try
        {
            var range = TimeSpan.FromMinutes(15);
            var step = TimeSpan.FromSeconds(15);

            // Fire all queries in parallel - one round trip's worth of latency per refresh.
            var orders = Scalar(q.OrdersPerMinute, ct);
            var revenue = Scalar(q.Revenue15m, ct);
            var failed = Scalar(q.FailedPercent, ct);
            var p95 = Scalar(q.P95ProcessingMs, ct);
            var circuits = _operatorView ? Scalar(InsightQueries.ActiveCircuits, ct) : Task.FromResult<double?>(null);
            var api5xx = _operatorView ? Scalar(InsightQueries.Api5xxPercent, ct) : Task.FromResult<double?>(null);
            var ordersByTenant = Prometheus.QueryAsync(q.OrdersPerMinuteByTenant, ct);
            var failuresByTenant = Prometheus.QueryAsync(q.FailuresPerMinuteByTenant, ct);
            var revenueByTenant = Prometheus.QueryAsync(q.RevenueByTenant, ct);
            var p95ByTenant = Prometheus.QueryAsync(q.P95ByTenant, ct);
            var ordersRange = Prometheus.QueryRangeAsync(q.OrdersPerMinuteByTenant, range, step, ct);
            var failuresRange = Prometheus.QueryRangeAsync(q.FailuresPerMinuteByTenant, range, step, ct);

            await Task.WhenAll(orders, revenue, failed, p95, circuits, api5xx,
                ordersByTenant, failuresByTenant, revenueByTenant, p95ByTenant, ordersRange, failuresRange);

            (_ordersPerMin, _revenue, _failedPct, _p95, _circuits, _api5xx) =
                (orders.Result, revenue.Result, failed.Result, p95.Result, circuits.Result, api5xx.Result);

            _ordersSeries = ToChart(ordersRange.Result);
            _failureSeries = ToChart(failuresRange.Result);
            _tenantRows = [.. (q.Tenant is { } t ? [t] : TenantTelemetry.KnownTenants).Select(tenant => new TenantRow(tenant,
                ValueFor(ordersByTenant.Result, tenant) ?? 0,
                ValueFor(failuresByTenant.Result, tenant) ?? 0,
                ValueFor(revenueByTenant.Result, tenant) ?? 0,
                ValueFor(p95ByTenant.Result, tenant) ?? double.NaN))];

            _error = null;
            _lastUpdate = DateTime.Now;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Prometheus refresh failed");
            _error = $"Prometheus query failed: {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task<double?> Scalar(string promql, CancellationToken ct) =>
        (await Prometheus.QueryAsync(promql, ct)).FirstOrDefault()?.Value;

    private static double? ValueFor(IReadOnlyList<PromSample> samples, string tenant) =>
        samples.FirstOrDefault(s => s.Labels.GetValueOrDefault("tenant_id") == tenant)?.Value;

    private static IReadOnlyList<LineChart.ChartSeries> ToChart(IReadOnlyList<PromSeries> series) =>
        [.. series.Select(s => new LineChart.ChartSeries(s.Labels.GetValueOrDefault("tenant_id", "?"), s.Points)).OrderBy(s => s.Name)];

    private async Task SetView(bool operatorView)
    {
        _operatorView = operatorView;
        await RefreshAsync(_cts.Token);
    }

    private void OnTenantChanged() => _ = RefreshAsync(_cts.Token);

    private async Task OnAdhocKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await RunAdhocAsync();
    }

    private async Task RunAdhocAsync()
    {
        try
        {
            _adhocResult = await Prometheus.QueryAsync(_adhocQuery, _cts.Token);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Tenant.Changed -= OnTenantChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
