@page "/"
@inject IOptions<GrafanaOptions> Grafana

<PageTitle>Overview</PageTitle>

<h1>.NET observability end-to-end</h1>
<p class="lead">A Blazor Server app instrumented with OpenTelemetry via Aspire service defaults,
    exporting the same telemetry to the Aspire dashboard and to a local Grafana (otel-lgtm).</p>

<pre class="arch">
 ┌──────────────────────────┐
 │ webfrontend              │   spans · metrics · logs
 │ (Blazor Server, .NET 10) │
 └────────────┬─────────────┘
              │ OTLP (two named exporters)
              ├────────────────────────┐
              ▼                        ▼
 ┌────────────────┐      ┌───────────────────────────┐
 │ Aspire         │      │ Local LGTM (Grafana,       │
 │ dashboard      │      │ Prometheus, Loki, Tempo)   │
 │ (dev loop)     │      └───────────────────────────┘
 └────────────────┘
</pre>

<div class="row g-3 mt-2">
    <div class="col-md-6">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Shop</h5>
            <p>Place orders. Each click is one trace: Blazor event → place order → inventory → payment.</p>
            <a class="btn btn-primary" href="shop">Go shopping</a>
        </div></div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Grafana.Value.Url))
{
    <p class="mt-4">Grafana: <a href="@Grafana.Value.Url" target="_blank">@Grafana.Value.Url</a> — Explore traces in Tempo, logs in Loki, metrics in Prometheus.</p>
}
