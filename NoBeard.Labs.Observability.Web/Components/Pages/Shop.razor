@page "/shop"
@implements IDisposable
@inject ShopApiClient Api
@inject TenantState Tenant
@inject IOptions<GrafanaOptions> Grafana
@inject ILogger<Shop> Logger

<PageTitle>Shop</PageTitle>

<h1>Shop <small class="text-muted fs-5">as <span style="color:@TenantColors.For(Tenant.Current)">@Tenant.Current</span></small></h1>

@if (_error is not null)
{
    <div class="alert alert-warning">@_error</div>
}

@if (_products is null)
{
    <p><em>Loading catalog (first call misses the Redis cache — look for the database span)…</em></p>
}
else
{
    <div class="row g-3">
        @foreach (var p in _products)
        {
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@p.Name</h5>
                        <p class="card-text fs-4">@p.Price.ToString("0.00") €</p>
                        <div class="mt-auto d-flex gap-2">
                            <button class="btn btn-primary" disabled="@_busy" @onclick="() => OrderAsync(p, 1)">Buy</button>
                            <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="() => BurstAsync(p)">Burst ×20</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<h4 class="mt-4">Your recent orders</h4>
<table class="table table-sm align-middle">
    <thead><tr><th>Time</th><th>Tenant</th><th>Result</th><th>Order</th><th>Trace</th></tr></thead>
    <tbody>
        @foreach (var r in _results)
        {
            <tr>
                <td>@r.At.ToString("HH:mm:ss")</td>
                <td><span class="tenant-dot" style="background:@TenantColors.For(r.Tenant)"></span> @r.Tenant</td>
                <td>
                    @if (r.Success)
                    {
                        <span class="badge bg-success">OK</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@(r.Error ?? r.StatusCode.ToString())</span>
                    }
                </td>
                <td>@(r.Order is { } o ? $"{o.OrderId} · {o.Quantity} × {o.ProductName} = {o.Total:0.00} €" : "—")</td>
                <td>
                    @if (Grafana.Value.TraceUrl(r.TraceId) is { } url)
                    {
                        <a href="@url" target="_blank"><code>@r.TraceId[..12]…</code></a>
                    }
                    else
                    {
                        <code>@r.TraceId</code>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private Product[]? _products;
    private readonly List<OrderResult> _results = [];
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        Tenant.Changed += OnTenantChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _products = await Api.GetProductsAsync(Tenant.Current);
            _error = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load catalog");
            _error = "Could not load the catalog — is the API running?";
        }
    }

    private async Task OrderAsync(Product p, int quantity)
    {
        var result = await Api.PlaceOrderAsync(Tenant.Current, p.Id, quantity, origin: "ui");
        _results.Insert(0, result);
        if (_results.Count > 25) _results.RemoveAt(_results.Count - 1);
    }

    private async Task BurstAsync(Product p)
    {
        _busy = true;
        try
        {
            var results = await Task.WhenAll(Enumerable.Range(0, 20)
                .Select(_ => Api.PlaceOrderAsync(Tenant.Current, p.Id, Random.Shared.Next(1, 4), origin: "ui-burst")));
            // All 20 orders share one trace: the .NET 10 Blazor event-handler span of this click is their parent.
            _results.InsertRange(0, results.OrderByDescending(r => r.At));
            if (_results.Count > 25) _results.RemoveRange(25, _results.Count - 25);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnTenantChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Tenant.Changed -= OnTenantChanged;
}
