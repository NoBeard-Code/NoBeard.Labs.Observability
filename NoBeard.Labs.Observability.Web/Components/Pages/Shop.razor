@page "/shop"
@rendermode InteractiveServer
@inject OrderService Orders

<PageTitle>Shop</PageTitle>

<h1>Shop</h1>

<div class="row g-3">
    @foreach (var p in Catalog.Products)
    {
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@p.Name</h5>
                    <p class="card-text fs-4">@p.Price.ToString("0.00") €</p>
                    <div class="mt-auto">
                        <button class="btn btn-primary" @onclick="() => OrderAsync(p)">Buy</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<h4 class="mt-4">Your recent orders</h4>
<table class="table table-sm align-middle">
    <thead><tr><th>Time</th><th>Result</th><th>Order</th></tr></thead>
    <tbody>
        @foreach (var r in _results)
        {
            <tr>
                <td>@r.At.ToString("HH:mm:ss")</td>
                <td>
                    @if (r.Success)
                    {
                        <span class="badge bg-success">OK</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@r.Error</span>
                    }
                </td>
                <td>@(r.Order is { } o ? $"{o.OrderId} · {o.Quantity} × {o.ProductName} = {o.Total:0.00} €" : "—")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private readonly List<OrderResult> _results = [];

    private async Task OrderAsync(Product p)
    {
        _results.Insert(0, await Orders.PlaceOrderAsync(p.Id, 1));
        if (_results.Count > 25) _results.RemoveAt(_results.Count - 1);
    }
}
