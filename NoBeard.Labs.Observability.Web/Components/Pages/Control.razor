@page "/control"
@inject ChaosSettings Chaos
@inject ILogger<Control> Logger
@inject TrafficGenerator Traffic

<PageTitle>Traffic & chaos</PageTitle>

<h1>Traffic &amp; chaos</h1>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card"><div class="card-body">
            <h5 class="card-title">Synthetic traffic</h5>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="traffic" @bind="Traffic.Enabled" />
                <label class="form-check-label" for="traffic">Generate orders in the background</label>
            </div>
            <label class="form-label">Orders per second: <strong>@Traffic.OrdersPerSecond.ToString("0.#")</strong></label>
            <input type="range" class="form-range" min="0.5" max="20" step="0.5" @bind="Traffic.OrdersPerSecond" @bind:event="oninput" />
        </div></div>
    </div>

    <div class="col-lg-7">
        <div class="card border-danger"><div class="card-body">
            <h5 class="card-title text-danger">Chaos (payment gateway)</h5>
            @if (_chaos is not null)
            {
                <label class="form-label">Failure rate: <strong>@_failureRate%</strong></label>
                <input type="range" class="form-range" min="0" max="100" step="5" @bind="_failureRate" @bind:event="oninput" />

                <label class="form-label">Extra latency: <strong>@_latency ms</strong></label>
                <input type="range" class="form-range" min="0" max="3000" step="100" @bind="_latency" @bind:event="oninput" />

                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-danger" @onclick="Apply">Apply</button>
                    <button class="btn btn-outline-secondary" @onclick="Reset">Reset to healthy</button>
                </div>
                <p class="mt-3 mb-0 small">Active: @(_chaos.FailureRate.ToString("P0")) failures, +@_chaos.ExtraLatencyMs ms</p>
            }
        </div></div>
    </div>
</div>

<div class="alert alert-info mt-4">
    <strong>Demo script:</strong> set 40% failures + 1500 ms → in Grafana watch <em>Failed orders %</em> and p95 climb
    → click an exemplar on the latency panel → trace → “Logs for this span”.
</div>

@code {
    private ChaosState? _chaos;
    private int _failureRate;
    private int _latency;

    protected override void OnInitialized() => Show(Chaos.Snapshot());

    private void Apply() => SetChaos(new(_failureRate / 100.0, _latency));

    private void Reset() => SetChaos(new(0.02, 0));

    private void SetChaos(ChaosState state)
    {
        Chaos.Apply(state);
        Logger.LogWarning("Chaos settings changed: failure rate {FailureRate:P0}, extra latency {ExtraLatencyMs} ms",
            state.FailureRate, state.ExtraLatencyMs);
        Show(Chaos.Snapshot());
    }

    private void Show(ChaosState state)
    {
        _chaos = state;
        _failureRate = (int)Math.Round(state.FailureRate * 100);
        _latency = state.ExtraLatencyMs;
    }
}
