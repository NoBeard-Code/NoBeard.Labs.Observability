// =====================================================================================================
// Grafana Alloy - LOCAL + GRAFANA CLOUD pipeline
//   apps --OTLP--> [receiver] -> [redact PII] -> [batch] -+-> local LGTM          (offline safety net)
//                                                         +-> Grafana Cloud OTLP  (metrics->Mimir, logs->Loki, traces->Tempo)
//   traces ---------------------------------------------> [host_info] -> Grafana Cloud (Application Observability)
// Credentials come from the AppHost parameters (user secrets) as environment variables.
// =====================================================================================================

logging {
  level  = "info"
  format = "logfmt"
}

otelcol.receiver.otlp "apps" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    metrics = [otelcol.processor.transform.redact.input]
    logs    = [otelcol.processor.transform.redact.input]
    traces  = [otelcol.processor.transform.redact.input]
  }
}

otelcol.processor.transform "redact" {
  error_mode = "ignore"

  trace_statements {
    context    = "span"
    statements = [
      `delete_key(attributes, "user.email")`,
      `replace_pattern(attributes["url.query"], "token=[^&]+", "token=REDACTED")`,
    ]
  }

  log_statements {
    context    = "log"
    statements = [
      `delete_key(attributes, "user.email")`,
    ]
  }

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [
      otelcol.processor.batch.default.input,
      otelcol.connector.host_info.default.input,
    ]
  }
}

// Grafana Cloud Application Observability expects a host-info metric derived from traces.
otelcol.connector.host_info "default" {
  host_identifiers = ["host.name"]

  output {
    metrics = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.otlphttp.lgtm.input, otelcol.exporter.otlphttp.grafana_cloud.input]
    logs    = [otelcol.exporter.otlphttp.lgtm.input, otelcol.exporter.otlphttp.grafana_cloud.input]
    traces  = [otelcol.exporter.otlphttp.lgtm.input, otelcol.exporter.otlphttp.grafana_cloud.input]
  }
}

otelcol.exporter.otlphttp "lgtm" {
  client {
    endpoint = sys.env("LGTM_OTLP_ENDPOINT")
    tls { insecure = true }
  }
}

otelcol.auth.basic "grafana_cloud" {
  username = sys.env("GRAFANA_CLOUD_INSTANCE_ID")
  password = sys.env("GRAFANA_CLOUD_API_TOKEN")
}

otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    // e.g. https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
    endpoint = sys.env("GRAFANA_CLOUD_OTLP_ENDPOINT")
    auth     = otelcol.auth.basic.grafana_cloud.handler
  }
}
